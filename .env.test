# ─────────────────────────────────────────────────────────────
# AMBIENTE DE TESTES (bun run dev:test / build:test)
# Sobrepõe o .env quando o modo é "test".
# Supabase vazio de propósito: o app cai no modo local (localStorage),
# totalmente isolado da produção. Nenhum dado real de cliente é tocado.
# ─────────────────────────────────────────────────────────────
VITE_APP_ENV=test
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
